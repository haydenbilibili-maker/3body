# 3body 后端环境变量示例
# 复制为 backend/.env（或项目根 .env）后按需修改。
# 变量前缀为 3BODY_；在 shell 里 export 时请改用 THREEBODY_ 前缀（以数字开头的变量名无法 export）。

# ---- LLM（智子 / 人物对话 / 零点计划网关），OpenAI 兼容协议 ----
# 本地 Ollama（默认）：先 ollama pull qwen2.5:7b
# 3BODY_LLM_BASE_URL=http://localhost:11434
# 3BODY_LLM_MODEL=qwen2.5:7b
# DeepSeek：
# 3BODY_LLM_BASE_URL=https://api.deepseek.com
# 3BODY_LLM_MODEL=deepseek-chat
# 3BODY_LLM_API_KEY=sk-...
# 3BODY_LLM_TIMEOUT=60

# 允许前端「人物志 → 与 TA 对话」里填写的 API Key / Base URL / Model 生效。
# 仅在本机使用时开启：开启后服务器会去请求前端给出的任意地址。
# 3BODY_LLM_ALLOW_CLIENT_OVERRIDE=false

# ---- RAG（智子对话检索原著），需 pip install -r backend/requirements-rag.txt ----
# 3BODY_DATA_DIR=./data
# 3BODY_CHROMA_PERSIST_DIR=./backend/chroma_db

# ---- 智子审计（/api/sophon/audit），SiliconFlow ----
# 3BODY_SILICONFLOW_API_KEY=
# 国内站 api.siliconflow.cn（默认）；国际站账号改为 https://api.siliconflow.com/v1
# 3BODY_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- 其他 ----
# 3BODY_DATABASE_URL=sqlite+aiosqlite:///3body.db
# 公网部署时限定前端来源，逗号分隔
# 3BODY_CORS_ORIGINS=https://haydenbilibili-maker.github.io
